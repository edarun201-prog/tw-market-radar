# 複製成 .env 後再修改
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radar

# 本機 PostgreSQL（不用 Docker）時使用；用 Docker 時會被 docker-compose.yml 的設定覆蓋
DATABASE_URL=postgresql://radar:radar@localhost:5432/radar
TEST_DATABASE_URL=postgresql://radar:radar@localhost:5432/radar_test
# 網站用唯讀帳號（migration 20260925000002 建立）
WEB_DATABASE_URL=postgresql://radar_web:radar_web@localhost:5432/radar

# 請求間隔（秒）。請不要調低，太頻繁會被證交所暫時封鎖 IP。
REQUEST_INTERVAL_SEC=4
REQUEST_TIMEOUT_SEC=30
MAX_RETRIES=3

# 驗證門檻
MIN_QUOTE_ROWS=800
MIN_FLOW_ROWS=500
MAX_ROW_CHANGE_RATIO=0.2

# 每日排程（台北時間）
SCHEDULE_HOUR=18
SCHEDULE_MINUTE=30
RETRY_EVERY_MIN=20
RETRY_UNTIL_HOUR=21
RETRY_UNTIL_MINUTE=30

# 盤中即時行情的資料來源：mis＝證交所基本市況報導網站（不需要金鑰，但只適合自己看）；off＝關閉。
# 上架讓別人看之前，需要先取得證交所（上櫃另有櫃買中心）的資訊使用授權，或改用已授權、可對外顯示的資訊廠商。
LIVE_PROVIDER=mis

# 公開網頁（選用）：每天把最新的單一 HTML 檔推到這個儲存庫的 gh-pages 分支（GitHub Pages）；留空就不發布。
# PAGES_REPO=https://github.com/<帳號>/tw-market-radar.git

# AI 盤後摘要（選用）：填入 Claude API 金鑰後，每日流程會自動產生摘要；留空就略過。
# 也可以改用 `ant auth login` 登入，不必寫在這裡。
# ANTHROPIC_API_KEY=
